generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique @db.VarChar(255)
  planType  String   @default("free") @map("plan_type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model School {
  id                     BigInt   @id @default(autoincrement())
  name                   String   @db.VarChar(255)
  area                   String   @db.VarChar(100)
  address                String   @db.VarChar(255)
  schoolType             String   @map("school_type") @db.VarChar(50)
  lifeBurdenLevel        String   @map("life_burden_level") @db.VarChar(20)
  timeBurdenLevel        String   @map("time_burden_level") @db.VarChar(20)
  mealType               String   @map("meal_type") @db.VarChar(50)
  itemBurdenLevel        String   @map("item_burden_level") @db.VarChar(20)
  diaperSupport          String?  @map("diaper_support") @db.VarChar(50)
  futonSupport           String?  @map("futon_support") @db.VarChar(50)
  extendedCareUsage      String   @map("extended_care_usage") @db.VarChar(20)
  weekdayEventsLevel     String   @map("weekday_events_level") @db.VarChar(20)
  parentAssociationLevel String   @map("parent_association_level") @db.VarChar(20)
  contactBookType        String?  @map("contact_book_type") @db.VarChar(50)
  absenceContactMethod   String?  @map("absence_contact_method") @db.VarChar(50)
  lessons                String?  @db.VarChar(255)
  allergySupport         String?  @map("allergy_support") @db.VarChar(255)
  description            String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([area])
  @@map("schools")
}